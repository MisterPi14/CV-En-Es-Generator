<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="UTF-8" />
  <title>{{ personal_info.name }} - CV</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="static/style.css" />
</head>
<body>
  <header class="cv-header">
    <h1 class="name">{{ personal_info.name }}</h1>
    <div class="contact-bar">
      {% if personal_info.phone %}<div class="contact-item"><i class="fa-solid fa-phone"></i><span>{{ personal_info.phone }}</span></div>{% endif %}
      {% if personal_info.email %}<div class="contact-item"><i class="fa-solid fa-envelope"></i><span><a href="mailto:{{ personal_info.email }}">{{ personal_info.email }}</a></span></div>{% endif %}
      {% if personal_info.linkedin_url %}
        {% set linkedin_user = personal_info.name.title() %}
        <div class="contact-item"><i class="fa-brands fa-linkedin"></i><span><a href="{{ personal_info.linkedin_url }}" target="_blank">{{ linkedin_user }}</a></span></div>
      {% endif %}
      {% if personal_info.github_url %}
        {% set github_user = personal_info.github_url.split('/')[-1] %}
        <div class="contact-item"><i class="fa-brands fa-github"></i><span><a href="{{ personal_info.github_url }}" target="_blank">{{ github_user }}</a></span></div>
      {% endif %}
    </div>
  </header>

  <div class="main-content">
    <section class="education">
      <h2>{{ ui.section_education }}</h2>
      {% for edu in education %}
      <div class="edu-item">
        <div class="degree">{{ edu.degree | markdown_links | safe }}</div>
        <div class="institution-period">{{ edu.institution | markdown_links | safe }} · <span class="period">{{ edu.period }}</span>{% if edu.gpa %} · <span>{{ "GPA:" if lang == 'en' else "Promedio:" }} {{ edu.gpa }}</span>{% endif %}</div>
        {% if edu['Relevant subjects'] %}
          <p class="edu-detail"><strong>{{ "Relevant subjects" if lang == 'en' else "Materias relevantes" }}</strong> {{ edu['Relevant subjects'] | markdown_links | safe }}</p>
        {% endif %}
        {% if edu['Extracurricular activities'] %}
          <div class="edu-detail">
            <strong>{{ "Extracurricular activities" if lang == 'en' else "Actividades extracurriculares" }}</strong>
            <ul>
            {% for activity in edu['Extracurricular activities'] %}
              <li>{{ activity | markdown_links | safe }}</li>
            {% endfor %}
            </ul>
          </div>
        {% endif %}
        {% if edu['Relevant projects'] %}
          <div class="edu-detail">
            <strong>{{ "Relevant projects" if lang == 'en' else "Proyectos relevantes" }}</strong>
            <ul>
            {% for r_proj in edu['Relevant projects'] %}
              {% if r_proj is mapping %}
                <li>
                  {{ r_proj.title | markdown_links | safe }}
                  {% if r_proj.subitems %}
                    <ul>
                    {% for sub_proj in r_proj.subitems %}
                      <li>{{ sub_proj | markdown_links | safe }}</li>
                    {% endfor %}
                    </ul>
                  {% endif %}
                </li>
              {% else %}
                <li>{{ r_proj | markdown_links | safe }}</li>
              {% endif %}
            {% endfor %}
            </ul>
          </div>
        {% endif %}
      </div>
      {% endfor %}
    </section>

    <section class="experience">
      <h2>{{ ui.section_experience }}</h2>
      {% for job in work_experience %}
      <div class="job">
        <div class="job-header">
          <div class="role-company"><span class="role">{{ job.role | default(job.title) | markdown_links | safe }}</span><span class="company-divider">|</span><span class="company">{{ job.company | markdown_links | safe }}</span></div>
          <div class="period">{{ job.period | default(job.location) }}</div>
        </div>
        <ul class="job-desc">
          {% for line in job.description.strip().split('\n') %}
            {% if line %}<li>{{ line | markdown_links | safe }}</li>{% endif %}
          {% endfor %}
        </ul>
      </div>
      {% endfor %}
    </section>

    {% if projects %}
    <section class="projects">
      <h2>{{ ui.section_projects }}</h2>
      {% for proj in projects %}
      <div class="job">
        <div class="job-header project-header">
          <div class="role-company"><span class="role">{{ proj.title | markdown_links | safe }}</span></div>
          <div class="period">{{ proj.period }}</div>
        </div>
        {% set proj_lines = proj.description.strip().split('\n') %}
        {% if proj_lines and proj_lines[0].strip() %}
          <p class="project-lead">{{ proj_lines[0] | markdown_links | safe }}</p>
        {% endif %}
        {% if proj_lines|length > 1 %}
          <ul class="job-desc">
            {% for line in proj_lines[1:] %}
              {% if line.strip() %}<li>{{ line | markdown_links | safe }}</li>{% endif %}
            {% endfor %}
          </ul>
        {% endif %}
      </div>
      {% endfor %}
    </section>
    {% endif %}
  </div>

  <div class="bottom-metrics-grid">
    <section class="skills-lang">
      <h2>{{ ui.section_languages }}</h2>
      <p class="bottom-paragraph">
        {% for lang in skills.programming_languages %}
        {{ lang }}{% if not loop.last %}, {% endif %}
        {% endfor %}
      </p>
    </section>

    <section class="skills-tech">
      <h2>{{ ui.section_technologies }}</h2>
      <p class="bottom-paragraph">
        {% for tech in skills.technologies_and_frameworks %}
        {{ tech }}{% if not loop.last %}, {% endif %}
        {% endfor %}
      </p>
    </section>

    {% if courses %}
    <section class="courses">
      <h2>{{ ui.section_courses }}</h2>
      <ul class="bottom-list">
        {% for course in courses %}
        <li>{{ course | markdown_links | safe }}</li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}

    {% if certifications %}
    <section class="certifications">
      <h2>{{ ui.section_certifications }}</h2>
      <ul class="bottom-list">
        {% for cert in certifications %}
        <li>{{ cert | markdown_links | safe }}</li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}
  </div>
</body>
</html>
