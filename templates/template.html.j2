<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="UTF-8" />
  <title>{{ personal_info.name }} - {{ personal_info.title }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="static/style.css" />
</head>
<body>
  <header class="cv-header">
    <h1 class="name">{{ personal_info.name }}</h1>
    <p class="title">{{ personal_info.title }}</p>
    <p class="contact">
      <span>{{ personal_info.email }}</span> ·
      <a href="{{ personal_info.linkedin_url }}" target="_blank">LinkedIn</a> ·
      <a href="{{ personal_info.github_url }}" target="_blank">GitHub</a>
    </p>
  </header>

  <section class="summary">
    <h2>{{ ui.section_summary }}</h2>
    <p>{{ summary | replace('\n', '<br>') | safe }}</p>
  </section>

  <section class="experience">
    <h2>{{ ui.section_experience }}</h2>
    {% for job in work_experience %}
    <div class="job">
      <div class="job-header">
        <div class="role">{{ job.role | default(job.title) | markdown_links | safe }}</div>
        <div class="company-period">{{ job.company | markdown_links | safe }} · <span class="period">{{ job.period }}</span></div>
      </div>
      <ul class="job-desc">
        {% for line in job.description.strip().split('\n') %}
          {% if line %}<li>{{ line | markdown_links | safe }}</li>{% endif %}
        {% endfor %}
      </ul>
    </div>
    {% endfor %}
  </section>

  {% if projects %}
  <section class="projects">
    <h2>{{ ui.section_projects }}</h2>
    {% for proj in projects %}
    <div class="job">
      <div class="job-header">
        <div class="role">{{ proj.title | markdown_links | safe }}</div>
        <div class="company-period"><span class="period">{{ proj.period }}</span></div>
      </div>
      <ul class="job-desc">
        {% for line in proj.description.strip().split('\n') %}
          {% if line %}<li>{{ line | markdown_links | safe }}</li>{% endif %}
        {% endfor %}
      </ul>
    </div>
    {% endfor %}
  </section>
  {% endif %}

  <section class="education">
    <h2>{{ ui.section_education }}</h2>
    {% for edu in education %}
    <div class="edu-item">
      <div class="degree">{{ edu.degree | markdown_links | safe }}</div>
      <div class="institution-period">{{ edu.institution | markdown_links | safe }} · <span class="period">{{ edu.period }}</span></div>
      {% if edu['Relevant subjects'] %}
        <p style="font-size: 0.9em; margin-top: 5px;"><strong>{{ "Relevant subjects:" if lang == 'en' else "Materias relevantes:" }}</strong> {{ edu['Relevant subjects'] | markdown_links | safe }}</p>
      {% endif %}
      {% if edu['Extracurricular activities'] %}
        <div style="font-size: 0.9em; margin-top: 5px;">
          <strong>{{ "Extracurricular activities:" if lang == 'en' else "Actividades extracurriculares:" }}</strong>
          <ul style="margin-top: 2px;">
          {% for activity in edu['Extracurricular activities'] %}
            <li>{{ activity | markdown_links | safe }}</li>
          {% endfor %}
          </ul>
        </div>
      {% endif %}
      {% if edu['Relevant projects'] %}
        <div style="font-size: 0.9em; margin-top: 5px;">
          <strong>{{ "Relevant projects:" if lang == 'en' else "Proyectos relevantes:" }}</strong>
          <ul style="margin-top: 2px;">
          {% for r_proj in edu['Relevant projects'] %}
            <li>{{ r_proj | markdown_links | safe }}</li>
          {% endfor %}
          </ul>
        </div>
      {% endif %}
    </div>
    {% endfor %}
  </section>

  {% if certifications %}
  <section class="certifications">
    <h2>{{ ui.section_certifications }}</h2>
    <ul class="skills-list" style="flex-direction: column;">
      {% for cert in certifications %}
      <li style="margin-bottom: 5px;">{{ cert | markdown_links | safe }}</li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  {% if courses %}
  <section class="courses">
    <h2>{{ ui.section_courses }}</h2>
    <ul class="skills-list" style="flex-direction: column;">
      {% for course in courses %}
      <li style="margin-bottom: 5px;">{{ course | markdown_links | safe }}</li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  <section class="skills">
    <h2>{{ ui.section_skills }}</h2>
    <ul class="skills-list">
      {% for skill in skills %}
      <li>{{ skill }}</li>
      {% endfor %}
    </ul>
  </section>
</body>
</html>
